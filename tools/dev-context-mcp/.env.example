# Copy to .env (or run `just env` to generate one with a random token).
# docker compose and the justfile both read .env automatically.

# REQUIRED — bearer token clients must send. Generate: openssl rand -hex 32
MCP_AUTH_TOKEN=replace-with-openssl-rand-hex-32

# REQUIRED for the SearXNG container. Generate: openssl rand -hex 32
SEARXNG_SECRET=replace-with-openssl-rand-hex-32

# Host path mounted at /workspace — the repo the server reads/searches/edits.
WORKSPACE=.

# Host port to publish the MCP on (loopback only).
MCP_PORT=3000

# Image flavor: browser (default, includes Playwright+Chromium) or runtime (lean).
# MCP_TARGET=browser

# web_search backend. The compose stack wires SEARXNG_URL to its own SearXNG
# service automatically; override here only to point elsewhere, or set a Tavily key.
# TAVILY_API_KEY=

# Opt into dangerous capability tiers (OFF by default in HTTP/hardened mode):
# MCP_ALLOW_EXEC=1
# MCP_ALLOW_WRITE=1
# MCP_ALLOW_ADMIN=1
