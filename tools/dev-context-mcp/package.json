{
  "name": "dev-context-mcp",
  "version": "4.0.0",
  "type": "module",
  "description": "Unified repo-scoped MCP server for AI coding assistants: token-capped search, reads and edits, git history/blame, diagnostics trimming, test failure reporting, optional read-only DB schema inspection, shell, and web tools. Runs over stdio or hardened HTTP.",
  "main": "dist/server.js",
  "bin": {
    "dev-context-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "modules",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node smoke-test.mjs && node --test \"test/**/*.test.js\"",
    "smoke": "node smoke-test.mjs",
    "test:modules": "node --test \"test/**/*.test.js\"",
    "typecheck": "tsc --noEmit && tsc -p modules/jsconfig.json",
    "dev": "tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:http": "node dist/server.js --http",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "ai",
    "developer-tools",
    "claude-code",
    "cursor",
    "token-efficiency"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1nn0v8r/toolshed.git",
    "directory": "tools/dev-context-mcp"
  },
  "homepage": "https://github.com/1nn0v8r/toolshed/tree/main/tools/dev-context-mcp#readme",
  "bugs": {
    "url": "https://github.com/1nn0v8r/toolshed/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.2.1",
    "fast-glob": "^3.3.3",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.2",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
