{
  "name": "dev-context-mcp",
  "version": "3.0.0",
  "type": "module",
  "description": "A portable, repo-scoped MCP server: read/search/edit files, run quality checks & shell, browse the web. Runs over stdio (local, full power) or HTTP (hardened, containerizable).",
  "main": "dist/server.js",
  "bin": {
    "dev-context-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "test": "node smoke-test.mjs",
    "smoke": "node smoke-test.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:http": "node dist/server.js --http"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "ai",
    "developer-tools"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.2.1",
    "fast-glob": "^3.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
