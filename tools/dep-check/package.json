{
  "name": "dep-check",
  "version": "0.1.0",
  "description": "Check for unused, missing, and misplaced dependencies in JavaScript and TypeScript projects.",
  "type": "module",
  "bin": {
    "dep-check": "src/cli.js"
  },
  "files": [
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "AGPL-3.0-only",
  "keywords": [
    "dependencies",
    "depcheck",
    "packages",
    "unused",
    "missing",
    "cli",
    "linter"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1nn0v8r/toolshed.git",
    "directory": "tools/dep-check"
  },
  "homepage": "https://github.com/1nn0v8r/toolshed/tree/main/tools/dep-check#readme",
  "bugs": {
    "url": "https://github.com/1nn0v8r/toolshed/issues"
  },
  "scripts": {
    "test": "node --test",
    "coverage": "node --test --experimental-test-coverage",
    "typecheck": "tsc -p jsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
